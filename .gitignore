# PlatformIO
firmware/.pio/
firmware/.pioenvs/
firmware/.piolibdeps/

# VS Code
.vscode/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc

# Dashboard backups
grafana-dashboards/*.json.backup

# Build artifacts
*.o
*.elf
*.bin
*.hex

# SD card recovery backup (contains WiFi password + user password hashes)
rpi-setup/sd-card-backup/

# Secrets — never commit (stored on the Pi at /mnt/sensor-data/config, chmod 600)
*.env
*.token

# Generated dashboard output (source of truth is sensors-config.json)
scripts/grafana-dashboards/
*secret*
*webhook*
slack_webhook_url
panel-health.env

# Firmware secrets (gitignored); keep the committed template
firmware/src/secrets.h
!firmware/src/secrets.h.example

# The secret *scanner* is not a secret — the *secret* pattern above catches it
!scripts/check-secrets.sh

# Local backups (may contain secrets/data — never commit)
*.backup
firmware/src/config.h.backup.*

# Claude Code worktrees and run-skill driver scratch state
.claude/worktrees/
.claude/skills/*/.work/
