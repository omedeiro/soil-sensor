/*
 * secrets.h.example
 * Template for firmware secrets. Copy this file to secrets.h and fill in your
 * real values. secrets.h is gitignored and must NEVER be committed.
 *
 *   cp firmware/src/secrets.h.example firmware/src/secrets.h
 *   # then edit firmware/src/secrets.h
 */

#ifndef SECRETS_H
#define SECRETS_H

// ─── WiFi credentials ────────────────────────────────────────────────────────
// Fallback credentials used if the WiFiManager captive portal times out.
// Leave empty ("") to rely solely on the captive-portal flow.
#define WIFI_SSID           "YOUR_WIFI_SSID"
#define WIFI_PASSWORD       "YOUR_WIFI_PASSWORD"

// ─── InfluxDB write token ────────────────────────────────────────────────────
// Generate in the InfluxDB UI (Load Data → API Tokens). Needs WRITE permission
// on the sensor-readings bucket.
#define INFLUX_TOKEN        "YOUR_INFLUXDB_WRITE_TOKEN"

#endif // SECRETS_H
