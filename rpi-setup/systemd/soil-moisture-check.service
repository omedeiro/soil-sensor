[Unit]
Description=Soil Moisture Low-Water Alert
Documentation=https://github.com/omedeiro/soil-sensor
After=network-online.target influxdb.service
Wants=network-online.target

[Service]
Type=oneshot
User=omedeiro
Group=omedeiro
WorkingDirectory=/home/omedeiro/soil-sensor

# Secrets and host-specific config (NOT committed to git).
# Created by install-slack-notifications.sh with chmod 600.
# Contains: INFLUX_TOKEN, INFLUX_URL, INFLUX_ORG, INFLUX_BUCKET, SENSORS_CONFIG
# The leading '-' makes the unit tolerate a missing file (logs a warning).
EnvironmentFile=-/mnt/sensor-data/config/soil-alerts.env

ExecStart=/home/omedeiro/soil-sensor/rpi-setup/scripts/check-soil-moisture.sh \
    --threshold 50 \
    --notify

StandardOutput=journal
StandardError=journal
SyslogIdentifier=soil-moisture-check

# Exit code 1 just means "a plant is dry" - that is a successful check,
# not a unit failure.
#
# Exit 2 (InfluxDB unreachable) is also not escalated here: that exact
# condition is already reported by sensor-health-check.service as a
# "System Down" alert, with a better explanation. Counting it as a failure
# too would send two Slack messages for one root cause.
SuccessExitStatus=0 1 2

# The alerting system reports its own breakage. Anything left - a config
# error (exit 3, usually a missing soil-alerts.env), a crash, a missing
# dependency - would otherwise be completely silent: the timer keeps ticking
# and no alert ever arrives.
OnFailure=alert-unit-failed@%n.service

PrivateTmp=false
NoNewPrivileges=true
MemoryMax=128M
CPUQuota=15%
Restart=no

[Install]
WantedBy=multi-user.target
