[Unit]
Description=Grafana Panel Health Monitor
Documentation=https://github.com/omedeiro/soil-sensor
After=network-online.target influxdb.service grafana-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=omedeiro
Group=omedeiro
WorkingDirectory=/home/omedeiro/soil-sensor

# Non-secret environment
Environment="PYTHONUNBUFFERED=1"

# Secrets and host-specific config (NOT committed to git).
# Created by install-panel-health-monitor.sh with chmod 600.
# Contains: INFLUX_TOKEN, INFLUX_URL, INFLUX_ORG, INFLUX_BUCKET,
#           GRAFANA_URL, GRAFANA_USER, GRAFANA_PASSWORD
# The leading '-' makes the unit tolerate a missing file (logs a warning).
EnvironmentFile=-/mnt/sensor-data/config/panel-health.env

# Script execution
ExecStart=/home/omedeiro/soil-sensor/scripts/repair-grafana-panels.sh --notify

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=grafana-panel-health

# Security
PrivateTmp=true
NoNewPrivileges=true

# Restart policy
Restart=no
