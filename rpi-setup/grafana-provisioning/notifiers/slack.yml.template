apiVersion: 1

# TEMPLATE - Copy to slack.yml and fill in your webhook URL
# Set SLACK_WEBHOOK_URL environment variable or edit this file

notifiers:
  - name: Slack Soil Alerts
    type: slack
    uid: slack-soil-alerts
    org_id: 1
    is_default: true
    send_reminder: true
    frequency: 4h
    settings:
      url: ${SLACK_WEBHOOK_URL}
      recipient: '#soil-sensor-alerts'
      username: Soil Monitor Bot
      icon_emoji: ':seedling:'
      uploadImage: true
      mentionChannel: here
