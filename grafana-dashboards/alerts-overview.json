    {
      "id": 3,
      "type": "stat",
      "title": "\ud83d\udce1 Sensors Offline",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "cflk0i2e2nwu8d"
      },
      "targets": [
        {
          "query": "// Count sensors that haven't sent heartbeat in last 10 minutes\n// Expected sensors = 4 (excluding backyard)\nexpectedSensors = 4\n\nactiveSensors = from(bucket: \"sensor-readings\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"sensor_heartbeat\")\n  |> filter(fn: (r) => r.location != \"backyard\")\n  |> keep(columns: [\"device_id\"])\n  |> distinct(column: \"device_id\")\n  |> count()\n  |> findRecord(fn: (key) => true, idx: 0)\n\n// Return count of offline sensors\nfrom(bucket: \"sensor-readings\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"sensor_heartbeat\")\n  |> limit(n: 1)\n  |> map(fn: (r) => ({\n      _time: now(),\n      _value: expectedSensors - activeSensors._value,\n      _field: \"offline_count\"\n  }))",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "0"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "short",
          "displayName": "Offline Count"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "\u2699\ufe0f System Health Score",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "cflk0i2e2nwu8d"
      },
      "targets": [
        {
          "query": "// Health score: (sensors online / 4 expected) * 100%\nactiveSensors = from(bucket: \"sensor-readings\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"sensor_heartbeat\")\n  |> filter(fn: (r) => r.location != \"backyard\")\n  |> keep(columns: [\"device_id\"])\n  |> distinct(column: \"device_id\")\n  |> count()\n\nactiveSensors\n  |> map(fn: (r) => ({\n      _time: now(),\n      _value: float(v: r._value) / 4.0 * 100.0,\n      _field: \"health_score\"\n  }))",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "displayName": "Health Score"
        }
      }
