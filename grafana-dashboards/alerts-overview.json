      "targets": [
        {
          "query": "// Get last heartbeat for each sensor in last 24h\nlastSeen = from(bucket: \"sensor-readings\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"sensor_heartbeat\")\n  |> filter(fn: (r) => r.location != \"backyard\")\n  |> group(columns: [\"device_id\"])\n  |> last()\n  |> keep(columns: [\"_time\", \"device_id\", \"location\"])\n\n// Filter to only those not seen in last 10 minutes\nlastSeen\n  |> filter(fn: (r) => r._time < experimental.subDuration(from: now(), d: 10m))\n  |> yield(name: \"offline\")",
