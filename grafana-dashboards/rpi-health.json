          "query": "// Check if InfluxDB is responding by querying recent data\nfrom(bucket: \"sensor-readings\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"rpi_system_metrics\" or r._measurement == \"sensor_reading\")\n  |> last()\n  |> count()\n  |> map(fn: (r) => ({\n      _time: now(),\n      _value: if r._value > 0 then 1 else 0,\n      _field: \"status\"\n  }))",
