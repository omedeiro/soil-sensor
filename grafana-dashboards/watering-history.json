    {
      "id": 101,
      "type": "stat",
      "title": "Sensor 1 - Last Watered",
      "description": "Time since Rubber Tree was last watered",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "cflk0i2e2nwu8d"
      },
      "targets": [
        {
          "query": "import \"interpolate\"\n\ndata = from(bucket: \"sensor-readings\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\")\n  |> filter(fn: (r) => r._field == \"moisture\")\n  |> filter(fn: (r) => r.device_id == \"sensor-1\")\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> interpolate.linear(every: 5m)\n\nevents = data\n  |> difference(nonNegative: false, columns: [\"_value\"])\n  |> filter(fn: (r) => r._value >= 15.0)\n\nevents\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: int(v: r._time) / int(v: 1000000)}))",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
