      },
      "targets": [
        {
          "query": "import \"date\"\nimport \"interpolate\"\n\n// Detect all watering events\ndata = from(bucket: \"sensor-readings\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\")\n  |> filter(fn: (r) => r._field == \"moisture\")\n  |> filter(fn: (r) => r.location != \"backyard\")\n  |> group(columns: [\"device_id\"])\n  |> sort(columns: [\"_time\"])\n  |> interpolate.linear(every: 5m)\n\nevents = data\n  |> difference(nonNegative: false, columns: [\"_value\"])\n  // Fast watering (15%+ single interval) or slow watering (8%+ single interval, catches drip irrigation)\n  |> filter(fn: (r) => r._value >= 8.0)\n\n// Extract hour and day of week\nevents\n  |> map(fn: (r) => ({\n      _time: r._time,\n      _value: 1.0,\n      hour: date.hour(t: r._time),\n      weekday: date.weekDay(t: r._time)\n    }))\n  |> group(columns: [\"hour\", \"weekday\"])\n  |> sum()\n  |> group()",
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 2,
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "steps": 64
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false
        },
        "tooltip": {
          "show": true,
          "yHistogram": false
        },
        "legend": {
          "show": true
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        }
