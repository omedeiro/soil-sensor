      },
      "options": {
        "mode": "html",
        "content": "<div style=\"text-align: center; padding: 15px;\">\n  <h1 style=\"font-size: 36px; margin: 0;\">\ud83d\udeb0 Watering History</h1>\n  <p style=\"font-size: 14px; color: #888; margin-top: 5px;\">Automatic detection of watering events (15%+ moisture increase in 30 minutes)</p>\n</div>"
      },
      "transparent": true
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Watering Events Timeline",
      "description": "Green bars indicate when each sensor was watered (2-hour watered status after detection)",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "cflk0i2e2nwu8d"
      },
      "targets": [
        {
          "query": "import \"interpolate\"\nimport \"date\"\n\n// Raw moisture data (pre-interpolation) for offline detection\nraw = from(bucket: \"sensor-readings\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\")\n  |> filter(fn: (r) => r._field == \"moisture\")\n  |> filter(fn: (r) => r.location != \"backyard\")\n  |> sort(columns: [\"_time\"])\n\n// Detect gaps > 15 minutes (offline state)\noffline = raw\n  |> elapsed(unit: 1m, timeColumn: \"_time\")\n  |> filter(fn: (r) => r.elapsed > 15)\n  |> map(fn: (r) => ({_time: r._time, _value: 4.0, device_id: r.device_id, _field: r._field, location: r.location}))\n  |> group(columns: [\"device_id\", \"_field\", \"location\"])\n\n// Interpolated data for continuous analysis\ninterp = raw\n  |> interpolate.linear(every: 5m)\n\n// Differences for watering/noise detection\ndiffs = interp\n  |> difference(nonNegative: false, columns: [\"_value\"])\n\n// State from moisture differences (watering or noise)\nstate_diff = diffs\n  |> map(fn: (r) => ({\n    _time: r._time,\n    _value: if r._value >= 8.0 then 2.0\n      else if r._value <= -8.0 then 3.0\n      else 0.0,\n    device_id: r.device_id,\n    _field: r._field,\n    location: r.location\n  }))\n  |> group(columns: [\"device_id\", \"_field\", \"location\"])\n\n// State from moisture level (dry when < 20%)\nstate_dry = interp\n  |> map(fn: (r) => ({\n    _time: r._time,\n    _value: if r._value < 20.0 then 1.0 else 0.0,\n    device_id: r.device_id,\n    _field: r._field,\n    location: r.location\n  }))\n  |> group(columns: [\"device_id\", \"_field\", \"location\"])\n\n// State from saturation (sensor railed at 100%)\n// Saturated(5) after 30+ min at >=99.5%, Not Working(6) after 24h+ at >=99.5%\nstate_sat = interp\n  |> stateDuration(fn: (r) => r._value >= 99.5, column: \"satMinutes\", unit: 1m)\n  |> map(fn: (r) => ({\n    _time: r._time,\n    _value: if r.satMinutes >= 1440 then 6.0\n      else if r.satMinutes >= 30 then 5.0\n      else 0.0,\n    device_id: r.device_id,\n    _field: r._field,\n    location: r.location\n  }))\n  |> group(columns: [\"device_id\", \"_field\", \"location\"])\n\n// Combine all states: not-working(6) > saturated(5) > offline(4) > noise(3) > watering(2) > dry(1) > normal(0)\nunion(tables: [state_diff, state_dry, offline, state_sat])\n  |> aggregateWindow(every: 30m, fn: max, createEmpty: false)\n  |> yield(name: \"states\")",
          "refId": "A"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          },
          "mappings": [
            {
              "type": "value",
