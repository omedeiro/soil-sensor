                  "color": "#FF9800"
                },
                "4": {
                  "text": "Offline",
                  "color": "#9E9E9E"
                },
                "5": {
                  "text": "Saturated",
                  "color": "#9C27B0"
                },
                "6": {
                  "text": "Not Working",
                  "color": "#B71C1C"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
