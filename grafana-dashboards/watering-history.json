        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"text-align: center; padding: 15px;\">\n  <h1 style=\"font-size: 36px; margin: 0;\">\ud83d\udeb0 Watering History</h1>\n  <p style=\"font-size: 14px; color: #888; margin-top: 5px;\">Automatic detection of watering events (15%+ moisture increase in 30 minutes)</p>\n</div>"
      },
      "transparent": true
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Watering Events Timeline",
      "description": "Green bars indicate when each sensor was watered (2-hour watered status after detection)",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "cflk0i2e2nwu8d"
      },
      "targets": [
        {
          "query": "import \"interpolate\"\nimport \"date\"\n\n// Get moisture readings for all sensors\ndata = from(bucket: \"sensor-readings\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\")\n  |> filter(fn: (r) => r._field == \"moisture\")\n  |> filter(fn: (r) => r.location != \"backyard\")\n  |> group(columns: [\"device_id\"])\n  |> sort(columns: [\"_time\"])\n  |> interpolate.linear(every: 5m)\n\n// Calculate point-to-point difference to detect sharp increases\nwatering_events = data\n  |> difference(nonNegative: false, columns: [\"_value\"])\n  |> map(fn: (r) => ({\n      r with\n      _value: if r._value >= 15.0 then 2.0 else if r._value >= 8.0 then 1.0 else 0.0\n    }))\n  |> aggregateWindow(every: 2h, fn: max, createEmpty: false)\n\nwatering_events",
          "refId": "A"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Normal",
                  "color": "transparent"
                },
                "1": {
                  "text": "Slow Watering",
                  "color": "#00BFFF"
                },
                "2": {
                  "text": "Fast Watering",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#00BFFF",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        },
