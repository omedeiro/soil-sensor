    {
      "id": 3,
      "type": "timeseries",
      "title": "Moisture Trend with Watering Markers",
      "description": "Moisture levels over time with vertical markers showing detected watering events",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "cflk0i2e2nwu8d"
      },
      "targets": [
        {
          "query": "from(bucket: \"sensor-readings\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\")\n  |> filter(fn: (r) => r._field == \"moisture\")\n  |> filter(fn: (r) => r.location != \"backyard\")\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)",
          "refId": "A"
        },
        {
          "query": "import \"interpolate\"\n\n// Detect fast watering events (15%+ increase in a single interval)\ndata = from(bucket: \"sensor-readings\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\")\n  |> filter(fn: (r) => r._field == \"moisture\")\n  |> filter(fn: (r) => r.location != \"backyard\")\n  |> group(columns: [\"device_id\"])\n  |> sort(columns: [\"_time\"])\n  |> interpolate.linear(every: 5m)\n\ndata\n  |> difference(nonNegative: false, columns: [\"_value\"])\n  |> filter(fn: (r) => r._value >= 15.0)\n  |> map(fn: (r) => ({r with _value: 100.0}))",
          "refId": "B"
        },
        {
          "query": "import \"interpolate\"\n\n// Detect slow watering events (8%+ increase, drip irrigation)\ndata = from(bucket: \"sensor-readings\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\")\n  |> filter(fn: (r) => r._field == \"moisture\")\n  |> filter(fn: (r) => r.location != \"backyard\")\n  |> group(columns: [\"device_id\"])\n  |> sort(columns: [\"_time\"])\n  |> interpolate.linear(every: 5m)\n\ndata\n  |> difference(nonNegative: false, columns: [\"_value\"])\n  |> filter(fn: (r) => r._value >= 8.0 and r._value < 15.0)\n  |> map(fn: (r) => ({r with _value: 95.0}))",
          "refId": "C"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last",
            "min",
            "max"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "smooth",
            "axisPlacement": "auto",
            "drawStyle": "line"
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
