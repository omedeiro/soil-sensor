      "title": "System Status",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "cflk0i2e2nwu8d"
      },
      "targets": [
        {
          "query": "from(bucket: \"sensor-readings\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"sensor_heartbeat\")\n  |> filter(fn: (r) => r.device_id =~ /^(sensor-1|sensor-2|sensor-3|sensor-4|sensor-5|sensor-6|sensor-7|sensor-8|sensor-9)$/)\n  |> group(columns: [\"device_id\"])\n  |> count()\n  |> group()\n  |> count()",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 9
              }
            ]
          },
          "unit": "short",
          "displayName": "Sensors Online (of 9)"
        }
      }
    },
