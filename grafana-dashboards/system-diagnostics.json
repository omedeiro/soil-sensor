              {
                "type": "range",
                "options": {
                  "from": -90,
                  "to": -80,
                  "result": {
                    "text": "Very Weak"
                  }
                }
              }
            ]
          }
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
