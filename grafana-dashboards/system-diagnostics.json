            "max": -30,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": -80
                },
                {
                  "color": "yellow",
                  "value": -70
                },
                {
                  "color": "green",
                  "value": -60
                },
                {
                  "color": "dark-green",
