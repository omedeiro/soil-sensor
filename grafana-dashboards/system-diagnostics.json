        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "influxdb",
              "uid": "cflk0i2e2nwu8d"
            },
            "query": "from(bucket: \"sensor-readings\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\")\n  |> filter(fn: (r) => r._field == \"rssi\")\n  |> filter(fn: (r) => r.device_id =~ /${device:regex}/)\n  |> group(columns: [\"device_id\"])\n  |> last()\n  |> map(fn: (r) => ({ r with _field: r.device_id }))"
