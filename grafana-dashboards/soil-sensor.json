    "templating": {
      "list": [
        {
          "name": "device",
          "label": "Sensor",
          "type": "query",
          "datasource": {
            "type": "influxdb",
            "uid": "cflk0i2e2nwu8d"
          },
          "query": "from(bucket: \"sensor-readings\") |> range(start: -7d) |> filter(fn: (r) => r._measurement == \"sensor_reading\") |> keep(columns: [\"device_id\"]) |> distinct(column: \"device_id\") |> rename(columns: {_value: \"value\"})",
          "refresh": 2,
          "includeAll": true,
          "multi": true,
          "allValue": ".*",
          "current": {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          "sort": 1
        }
      ]
    },
    "panels": [
