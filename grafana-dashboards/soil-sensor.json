      {
        "id": 7,
        "title": "Soil Moisture % Over Time",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 8, "w": 24, "h": 10 },
        "datasource": { "type": "influxdb", "uid": "cflk0i2e2nwu8d" },
        "fieldConfig": {
