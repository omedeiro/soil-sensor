{
  "dashboard": {
    "id": null,
    "uid": "soil-sensor-v1",
    "title": "🌱 Soil Sensor Dashboard",
    "tags": ["soil", "sensor", "esp8266"],
    "timezone": "browser",
    "refresh": "5m",
    "schemaVersion": 38,
    "version": 1,
    "time": { "from": "now-24h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "Soil Moisture %",
        "type": "gauge",
        "gridPos": { "x": 0, "y": 0, "w": 6, "h": 8 },
        "datasource": { "type": "influxdb", "uid": "cflk0i2e2nwu8d" },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 20 },
                { "color": "green", "value": 40 },
                { "color": "blue", "value": 80 }
              ]
            }
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "cflk0i2e2nwu8d" },
            "query": "from(bucket: \"sensor-readings\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\")\n  |> filter(fn: (r) => r._field == \"moisture\")\n  |> last()"
          }
        ]
      },
      {
        "id": 2,
        "title": "WiFi Signal (RSSI)",
        "type": "gauge",
        "gridPos": { "x": 6, "y": 0, "w": 6, "h": 8 },
        "datasource": { "type": "influxdb", "uid": "cflk0i2e2nwu8d" },
        "fieldConfig": {
          "defaults": {
            "unit": "dBm",
            "min": -90,
            "max": -30,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": -75 },
                { "color": "green", "value": -60 }
              ]
            }
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "cflk0i2e2nwu8d" },
            "query": "from(bucket: \"sensor-readings\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\")\n  |> filter(fn: (r) => r._field == \"rssi\")\n  |> last()"
          }
        ]
      },
      {
