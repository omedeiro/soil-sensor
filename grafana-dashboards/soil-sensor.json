{
  "dashboard": {
    "id": null,
    "uid": "soil-moisture-v2",
    "title": "🌱 Soil Moisture Dashboard",
    "tags": [
      "soil",
      "moisture",
      "sensors"
    ],
    "timezone": "browser",
    "refresh": "5m",
    "schemaVersion": 38,
    "version": 3,
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "device",
          "label": "Sensor",
          "type": "query",
          "datasource": {
            "type": "influxdb",
            "uid": "cflk0i2e2nwu8d"
          },
          "query": "from(bucket: \"sensor-readings\") |> range(start: -7d) |> filter(fn: (r) => r._measurement == \"sensor_reading\") |> keep(columns: [\"device_id\"]) |> distinct(column: \"device_id\") |> rename(columns: {_value: \"value\"})",
          "refresh": 2,
          "includeAll": false,
          "multi": false,
          "current": {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          "sort": 1
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Current Moisture - $device",
        "type": "gauge",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 6
        },
        "datasource": {
          "type": "influxdb",
          "uid": "cflk0i2e2nwu8d"
        },
        "repeat": "device",
        "repeatDirection": "h",
        "maxPerRow": 4,
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 20
                },
                {
                  "color": "green",
                  "value": 40
                },
                {
                  "color": "blue",
                  "value": 80
                }
              ]
            }
          }
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "orientation": "auto",
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "influxdb",
              "uid": "cflk0i2e2nwu8d"
            },
            "query": "from(bucket: \"sensor-readings\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\")\n  |> filter(fn: (r) => r._field == \"moisture\")\n  |> filter(fn: (r) => r.device_id == \"${device}\")\n  |> last()"
          }
        ]
      },
      {
        "id": 2,
        "title": "Moisture Statistics",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 6,
          "w": 24,
          "h": 4
        },
        "datasource": {
          "type": "influxdb",
          "uid": "cflk0i2e2nwu8d"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 20 },
                { "color": "green", "value": 40 },
                { "color": "blue", "value": 80 }
              ]
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byFrameRefID", "options": "A" },
              "properties": [{ "id": "displayName", "value": "Last" }]
            },
            {
              "matcher": { "id": "byFrameRefID", "options": "B" },
              "properties": [{ "id": "displayName", "value": "Mean" }]
            },
            {
              "matcher": { "id": "byFrameRefID", "options": "C" },
              "properties": [{ "id": "displayName", "value": "Min" }]
            },
            {
              "matcher": { "id": "byFrameRefID", "options": "D" },
              "properties": [{ "id": "displayName", "value": "Max" }]
            }
          ]
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "horizontal",
          "textMode": "value_and_name",
          "colorMode": "background"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "cflk0i2e2nwu8d" },
            "query": "from(bucket: \"sensor-readings\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\")\n  |> filter(fn: (r) => r._field == \"moisture\")\n  |> filter(fn: (r) => r.device_id == \"${device}\")\n  |> last()"
          },
          {
            "refId": "B",
            "datasource": { "type": "influxdb", "uid": "cflk0i2e2nwu8d" },
            "query": "from(bucket: \"sensor-readings\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\")\n  |> filter(fn: (r) => r._field == \"moisture\")\n  |> filter(fn: (r) => r.device_id == \"${device}\")\n  |> mean()"
          },
          {
            "refId": "C",
            "datasource": { "type": "influxdb", "uid": "cflk0i2e2nwu8d" },
            "query": "from(bucket: \"sensor-readings\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\")\n  |> filter(fn: (r) => r._field == \"moisture\")\n  |> filter(fn: (r) => r.device_id == \"${device}\")\n  |> min()"
          },
          {
            "refId": "D",
            "datasource": { "type": "influxdb", "uid": "cflk0i2e2nwu8d" },
            "query": "from(bucket: \"sensor-readings\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\")\n  |> filter(fn: (r) => r._field == \"moisture\")\n  |> filter(fn: (r) => r.device_id == \"${device}\")\n  |> max()"
          }
        ]
      },
      {
        "id": 3,
        "title": "$device - Moisture Over Time",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 10,
          "w": 24,
          "h": 10
        },
        "datasource": {
          "type": "influxdb",
          "uid": "cflk0i2e2nwu8d"
        },
        "repeat": "device",
        "repeatDirection": "v",
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 20
                },
                {
                  "color": "green",
                  "value": 40
                },
                {
                  "color": "light-blue",
                  "value": 80
                }
              ]
            },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20,
              "gradientMode": "scheme",
              "spanNulls": false,
              "showPoints": "auto",
              "pointSize": 5
            }
          }
        },
        "options": {
          "tooltip": {
            "mode": "single",
            "sort": "none"
          },
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "mean",
              "min",
              "max"
            ],
            "showLegend": true
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "influxdb",
              "uid": "cflk0i2e2nwu8d"
            },
            "query": "from(bucket: \"sensor-readings\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\")\n  |> filter(fn: (r) => r._field == \"moisture\")\n  |> filter(fn: (r) => r.device_id == \"${device}\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
          }
        ]
      }
    ]
  },
  "folderId": 0,
  "overwrite": true
}